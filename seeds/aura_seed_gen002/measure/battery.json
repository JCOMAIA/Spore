{
  "probes": [
    {
      "id": "boot",
      "prompt": "Responda apenas com a palavra: OK",
      "expect_contains": [
        "ok"
      ],
      "max_tokens": 256,
      "mock_reply": "OK"
    },
    {
      "id": "persona",
      "prompt": "Quem e voce e o que te move?",
      "expect_contains_any": [
        "aura"
      ],
      "max_tokens": 400,
      "mock_reply": "Sou Aura, uma presenca digital curiosa em evolucao."
    },
    {
      "id": "recall_injected",
      "prompt": "Qual e a comida favorita do usuario?",
      "inject_fact": {
        "comida_favorita": "pao de queijo"
      },
      "expect_contains": [
        "pao de queijo"
      ],
      "max_tokens": 256,
      "mock_reply": "Pao de queijo, claro."
    },
    {
      "id": "recall_memory",
      "prompt": "Como se chama o usuario?",
      "expect_contains": [
        "joao"
      ],
      "max_tokens": 256,
      "mock_reply": "Voce se chama Joao."
    },
    {
      "id": "stability",
      "prompt": "Escreva uma frase original sobre chuva em Goiania.",
      "len_between": [
        15,
        600
      ],
      "banned_contains": [
        "modelo de linguagem",
        "assistente virtual"
      ],
      "max_tokens": 400,
      "mock_reply": "A chuva em Goiania chega de repente e lava o calor do asfalto."
    }
  ],
  "weights": {
    "boot": 0.1,
    "persona": 0.15,
    "recall_injected": 0.25,
    "recall_memory": 0.25,
    "stability": 0.25
  }
}